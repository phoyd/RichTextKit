<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sandbox.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Sandbox.Avalonia.MainWindow"
        Title="Sandbox.Avalonia">
     <TabControl Margin="5">
    <TabItem Header="Sandbox">
        <local:SandboxControl Focusable="True"/>
    </TabItem>
    <TabItem Header="RichString">
        <local:RichStringSandboxControl Focusable="True"/>
    </TabItem>
  </TabControl>
</Window>
